datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
  APPROVAL_PENDING
  INACTIVE
}

enum JobStatus {
  DRAFT
  SENT
  APPROVED
  ACCEPTED
}

enum JobMemberRole {
  OWNER
  CUSTOMER
  TRADIE
  COLLABORATOR
}

enum MessageAuthor {
  AI
  USER
  SYSTEM
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
}

enum QuoteStatus {
  DRAFT
  READY
  SENT
  VIEWED
  APPROVED
  REJECTED
  EXPIRED
}

enum ActivityInitiator {
  AI
  USER
}

//////////////////////////////////////////////////////
// PLAN
//////////////////////////////////////////////////////

model Plan {
  id          String  @id
  name        String
  description String?
  price       Int
  currency    String

  billing_interval String?

  isFree Boolean @default(true)

  paypal_plan_id    String? @unique
  paypal_product_id String?

  environment String
  version     Int
  isActive    Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  limits        PlanLimit[]

  @@index([environment, isActive])
}

//////////////////////////////////////////////////////
// PLAN LIMITS
//////////////////////////////////////////////////////

model PlanLimit {
  id String @id @default(cuid())

  plan_id String
  plan    Plan   @relation(fields: [plan_id], references: [id])

  text_limit  Int
  image_limit Int

  interval String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plan_id, interval])
}

//////////////////////////////////////////////////////
// SUBSCRIPTION
//////////////////////////////////////////////////////

model Subscription {
  id String @id @default(cuid())

  firebase_uid String

  plan_id String
  plan    Plan   @relation(fields: [plan_id], references: [id])

  paypal_subscription_id String? @unique

  status SubscriptionStatus

  start_date        DateTime?
  next_billing_date DateTime?
  end_date          DateTime?

  cancel_at_period_end Boolean @default(false)

  grace_period_end     DateTime?
  failed_payment_count Int       @default(0)

  last_payment_date   DateTime?
  last_payment_amount Int?
  currency            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firebase_uid, status])
  @@index([firebase_uid, end_date])
  @@index([status])
  @@index([next_billing_date])
}

//////////////////////////////////////////////////////
// USAGE
//////////////////////////////////////////////////////

model Usage {
  id String @id @default(cuid())

  firebase_uid String
  plan_id      String

  text_count  Int @default(0)
  image_count Int @default(0)

  period_start DateTime
  period_end   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([firebase_uid, plan_id, period_start])
  @@index([firebase_uid])
}

//////////////////////////////////////////////////////
// CHAT
//////////////////////////////////////////////////////

model Chat {
  id String @id @default(cuid())

  job Job?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// JOB
//////////////////////////////////////////////////////

model Job {
  id String @id @default(cuid())

  // Firebase UID of job owner
  uid String

  // One chat per job
  chatId String @unique
  chat   Chat   @relation(fields: [chatId], references: [id])

  title            String
  description      String  @db.Text
  scope            String  @db.Text
  technicalDetails String? @db.Text

  // AI-generated job analysis
  analysisNote String? @db.Text

  status JobStatus @default(DRAFT)

  messages Conversation[]
  quotes   Quote[]
  members  JobMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uid, status])
  @@index([uid, updatedAt])
}

//////////////////////////////////////////////////////
// JOB MEMBERS
//////////////////////////////////////////////////////

model JobMember {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Firebase UID
  uid  String
  role JobMemberRole

  createdAt DateTime @default(now())

  @@unique([jobId, uid])
  @@index([uid])
}

//////////////////////////////////////////////////////
// CONVERSATION
//////////////////////////////////////////////////////

model Conversation {
  msgId String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Firebase UID; nullable for AI/system messages
  uid String?

  author  MessageAuthor
  message String        @db.Text

  media MessageMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, createdAt])
  @@index([uid])
}

//////////////////////////////////////////////////////
// MESSAGE MEDIA
//////////////////////////////////////////////////////

model MessageMedia {
  id String @id @default(cuid())

  msgId        String
  conversation Conversation @relation(fields: [msgId], references: [msgId], onDelete: Cascade)

  type MediaType
  url  String    @db.Text

  // AI-generated media analysis
  analysisNote String? @db.Text

  fileName String?
  mimeType String?
  fileSize Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([msgId])
}

//////////////////////////////////////////////////////
// QUOTE
//////////////////////////////////////////////////////

model Quote {
  quoteId String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Firebase UID of creator
  uid String

  status QuoteStatus @default(DRAFT)

  // Currently active version
  currentVersionId String?

  // All versions belonging to this quote
  versions QuoteVersion[] @relation("QuoteVersions")

  // Composite relation guarantees version ownership
  currentVersion QuoteVersion? @relation("CurrentQuoteVersion", fields: [quoteId, currentVersionId], references: [quoteId, versionId], onDelete: Restrict)

  access     QuoteAccess[]
  activities QuoteActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([uid])
  @@index([status])
  @@index([currentVersionId])
}

//////////////////////////////////////////////////////
// QUOTE VERSION
//////////////////////////////////////////////////////

model QuoteVersion {
  versionId String @id @default(cuid())

  quoteId String

  // Parent quote relationship
  quote Quote @relation("QuoteVersions", fields: [quoteId], references: [quoteId], onDelete: Cascade)

  // Reverse relation for active version
  currentFor Quote[] @relation("CurrentQuoteVersion")

  // Example: v1, v1.1, v2
  version       String
  versionNumber Int

  title   String
  details String @db.Text

  // AI-generated supporting context
  supportedContext String? @db.Text

  health     QuoteHealth?
  activities QuoteActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quoteId, version])
  @@unique([quoteId, versionNumber])
  // Required for composite foreign key
  @@unique([quoteId, versionId])
  @@index([quoteId, createdAt])
}

//////////////////////////////////////////////////////
// QUOTE ACCESS
//////////////////////////////////////////////////////

model QuoteAccess {
  id String @id @default(cuid())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [quoteId], onDelete: Cascade)

  // Firebase UID of authorized user
  uid String

  createdAt DateTime @default(now())

  @@unique([quoteId, uid])
  @@index([uid])
}

//////////////////////////////////////////////////////
// QUOTE HEALTH
//////////////////////////////////////////////////////

model QuoteHealth {
  id String @id @default(cuid())

  versionId String       @unique
  version   QuoteVersion @relation(fields: [versionId], references: [versionId], onDelete: Cascade)

  // COMPLETENESS CHECKS

  scopeDefined    Boolean?
  labourEstimated Boolean?
  materialsAdded  Boolean?
  pricingSet      Boolean?
  customerMessage Boolean?

  // ACCURACY CHECKS

  lineItemsVerified  Boolean?
  subtotalVerified   Boolean?
  discountVerified   Boolean?
  taxVerified        Boolean?
  grandTotalVerified Boolean?
  pricingConsistent  Boolean?

  // VALIDATION METADATA

  checkedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

//////////////////////////////////////////////////////
// QUOTE ACTIVITY / TRACE
//////////////////////////////////////////////////////

model QuoteActivity {
  activityId String @id @default(cuid())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [quoteId], onDelete: Cascade)

  versionId String
  version   QuoteVersion @relation(fields: [versionId], references: [versionId], onDelete: Cascade)

  title       String
  description String? @db.Text

  initiator ActivityInitiator

  // Lucide icon name
  icon String

  // Actual activity occurrence time
  occurredAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId, occurredAt])
  @@index([versionId, occurredAt])
}
